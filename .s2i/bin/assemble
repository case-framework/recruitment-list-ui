#!/usr/bin/env bash

set -euo pipefail
shopt -s dotglob

if [[ -f /tmp/src/package.json ]]; then
  mv /tmp/src/* .
fi

if [[ ! -f package.json ]]; then
  echo "S2I assemble error: package.json is missing from the application root ($(pwd))." >&2
  exit 1
fi

if ! PNPM_VERSION=$(node -e '
  const packageManager = require("./package.json").packageManager;
  if (typeof packageManager !== "string" || !packageManager.startsWith("pnpm@") || !packageManager.slice(5)) {
    console.error("S2I assemble error: package.json must declare a pnpm packageManager (for example, pnpm@11.16.0).");
    process.exit(1);
  }
  process.stdout.write(packageManager.slice(5));
'); then
  exit 1
fi

PNPM_CMD=()

if command -v pnpm >/dev/null 2>&1 && pnpm --version >/dev/null 2>&1; then
  PNPM_CMD=(pnpm)
elif command -v corepack >/dev/null 2>&1; then
  corepack prepare "pnpm@${PNPM_VERSION}" --activate >/dev/null 2>&1 || true
  if corepack pnpm --version >/dev/null 2>&1; then
    PNPM_CMD=(corepack pnpm)
  fi
fi

if ((${#PNPM_CMD[@]} == 0)) && command -v npx >/dev/null 2>&1; then
  if ! PNPM_CACHE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/pnpm-cache.XXXXXX"); then
    echo "S2I assemble error: could not create a writable npm cache directory for the npx pnpm fallback." >&2
    exit 1
  fi
  export npm_config_cache="$PNPM_CACHE_DIR"
  candidate=(npx --yes "pnpm@${PNPM_VERSION}")
  if "${candidate[@]}" --version >/dev/null 2>&1; then
    PNPM_CMD=("${candidate[@]}")
  fi
fi

if ((${#PNPM_CMD[@]} == 0)); then
  echo "S2I assemble error: could not provide pnpm@${PNPM_VERSION} via installed pnpm, Corepack, or npx." >&2
  exit 1
fi

"${PNPM_CMD[@]}" install --frozen-lockfile
"${PNPM_CMD[@]}" build
